<%@ Master Language="C#" AutoEventWireup="true" CodeBehind="Sidebar.master.cs" Inherits="TasteNet.Sidebar" %>

<!DOCTYPE html>
<html lang="en">
<head runat="server">
    <meta charset="utf-8" />
    <title>TasteNet Admin</title>

    <!-- Font Awesome -->
    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css" rel="stylesheet" />

    <!-- Google Font -->
    <link href="https://fonts.googleapis.com/css2?family=Poppins:wght@300;400;600&display=swap" rel="stylesheet" />

    <style>
        body {
            margin: 0;
            font-family: 'Poppins', sans-serif;
            background: #1e1e1e;
        }

        /* ===== SIDEBAR ===== */
        .sidebar {
            width: 280px;
            height: 100vh;
            background: linear-gradient(180deg, #7b0000, #3b0000);
            color: #fff;
            position: fixed;

            /* SCROLLBAR */
            overflow-y: auto;
            overflow-x: hidden;
        }

        /* Scrollbar style (Chrome, Edge, Safari) */
        .sidebar::-webkit-scrollbar {
            width: 6px;
        }

        .sidebar::-webkit-scrollbar-track {
            background: rgba(255,255,255,0.1);
        }

        .sidebar::-webkit-scrollbar-thumb {
            background: #ffc107;
            border-radius: 10px;
        }

        /* Firefox */
        .sidebar {
            scrollbar-width: thin;
            scrollbar-color: #ffc107 rgba(255,255,255,0.1);
        }

        .sidebar-header {
            text-align: center;
            padding: 25px 15px;
            border-bottom: 1px solid rgba(255,255,255,.2);
            border-radius: 50%;
        }

        .sidebar-header img {
            width: 70px;
            margin-bottom: 10px;
            border-radius: 50%;
        }

        .sidebar-header h2 {
            margin: 0;
            font-size: 22px;
            color: #ffc107;
        }

        .sidebar-header span {
            font-size: 14px;
            opacity: .9;
        }

        .menu {
            padding: 15px 0;
        }

        .menu-title {
            padding: 10px 25px;
            font-size: 13px;
            text-transform: uppercase;
            opacity: .8;
        }

        .menu a {
            display: flex;
            align-items: center;
            padding: 12px 25px;
            color: #fff;
            text-decoration: none;
            transition: .3s;
        }

        .menu a i {
            width: 25px;
            font-size: 18px;
        }

        .menu a:hover,
        .menu a.active {
            background: rgba(255,255,255,.15);
            color: #ffc107;
        }

        /* ===== CONTENT ===== */
        .content {
            margin-left: 280px;
            padding: 25px;
            color: #fff;
        }
    </style>

</head>
<body>
    <form runat="server">

        <!-- SIDEBAR -->
        <div class="sidebar">
            <div class="sidebar-header">
                <img src="images/logo.png" alt="Logo" />
                <h2>Caballeros TasteNet</h2>
                <span>Admin</span>
            </div>

            <div class="menu">
                <div class="menu-title">Overview</div>
                <a href="Dashboard.aspx" class="active">
                    <i class="fa-solid fa-house"></i> Dashboard
                </a>

                <div class="menu-title">Users</div>
                <a href="UserManagement.aspx">
                    <i class="fa-solid fa-user"></i> User Management
                </a>
                <a href="DeliveryPersonnel.aspx">
                    <i class="fa-solid fa-motorcycle"></i> Delivery Personnel
                </a>

                <div class="menu-title">Menu & Stock</div>
                <a href="StockManagement.aspx">
                    <i class="fa-solid fa-box"></i> Stock Management
                </a>
                <a href="Categories.aspx">
                    <i class="fa-solid fa-list"></i> Categories
                </a>

                <div class="menu-title">Orders</div>
                <a href="AllOrders.aspx">
                    <i class="fa-solid fa-receipt"></i> All Orders
                </a>
                <div class="menu-title">Payments</div>
                <a href="Transactions.aspx">
                    <i class="fa-solid fa-dollar-sign"></i> Transaction
                </a>

                <div class="menu-title">Analytics</div>
                <a href="Reports.aspx">
                    <i class="fa-solid fa-chart-column"></i> Reports
                </a>
                <div class="menu-title">Analytics</div>
                <a href="PromoCodes.aspx">
                    <i class="fa-solid fa-tag"></i> Promo Codes
                </a>

                <div class="menu-title">Settings</div>
                <a href="Settings.aspx">
                    <i class="fa-solid fa-gear"></i> Settings
                </a>
                <a href="Login.aspx">
                    <i class="fa-solid fa-right-from-bracket"></i> Log Out
                </a>
            </div>
        </div>

        <!-- MAIN CONTENT -->
        <div class="content">
            <asp:ContentPlaceHolder ID="MainContent" runat="server" />
        </div>

    </form>
</body>
</html>
