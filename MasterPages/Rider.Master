<%@ Master Language="C#" AutoEventWireup="true" CodeBehind="Rider.master.cs" Inherits="TasteNet.MasterPages.Rider" %>

<!DOCTYPE html>
<html>
<head runat="server">
    <title>Rider Portal</title>

    <!-- Font Awesome for Icons -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css"/>

    <style>
        body {
            margin: 0;
            font-family: 'Segoe UI', sans-serif;
            background: #f5f5f5;
        }

        .rider-layout {
            display: flex;
            height: 100vh;
        }

        /* Sidebar */
        .sidebar {
            width: 260px;
            background: #ffffff;
            padding: 20px;
            box-shadow: 2px 0 8px rgba(0,0,0,0.05);
        }

        .sidebar-header {
            display: flex;
            justify-content: space-between;
            align-items: center;
            margin-bottom: 30px;
        }

        .sidebar-header h2 {
            font-size: 20px;
            color: #b00000;
            margin: 0;
        }

        .close-btn {
            font-size: 18px;
            cursor: pointer;
            color: #333;
        }

        .menu {
            list-style: none;
            padding: 0;
            margin: 0;
        }

        .menu li {
            margin-bottom: 12px;
        }

        .menu a {
            display: flex;
            align-items: center;
            gap: 12px;
            padding: 12px 15px;
            text-decoration: none;
            color: #333;
            border-radius: 10px;
            font-size: 15px;
            transition: 0.2s ease;
        }

        .menu a i {
            width: 20px;
            text-align: center;
        }

        .menu a:hover {
            background: #f1f1f1;
        }

        .menu a.active {
            background: #8b0000;
            color: #fff;
        }

        /* Main Content */
        .main-content {
            flex: 1;
            padding: 30px;
        }
    </style>

    <asp:ContentPlaceHolder ID="head" runat="server" />
</head>

<body>
    <form id="form1" runat="server">
        <div class="rider-layout">

            <!-- Sidebar -->
            <aside class="sidebar">
                <div class="sidebar-header">
                    <h2>Rider Portal</h2>
                    <span class="close-btn">&times;</span>
                </div>

                <ul class="menu">
                    <li>
                        <a href="Dashboard.aspx" class="active">
                            <i class="fa-solid fa-cube"></i>
                            Dashboard
                        </a>
                    </li>
                    <li>
                        <a href="DeliveryHistory.aspx">
                            <i class="fa-solid fa-clock-rotate-left"></i>
                            Delivery History
                        </a>
                    </li>
                    <li>
                        <a href="Earnings.aspx">
                            <i class="fa-solid fa-dollar-sign"></i>
                            Earnings
                        </a>
                    </li>
                    <li>
                        <a href="Notifications.aspx">
                            <i class="fa-solid fa-bell"></i>
                            Notifications
                        </a>
                    </li>
                    <li>
                        <a href="Profile.aspx">
                            <i class="fa-solid fa-user"></i>
                            Profile
                        </a>
                    </li>
                    <li>
                        <a href="Settings.aspx">
                            <i class="fa-solid fa-gear"></i>
                            Settings
                        </a>
                    </li>
                    <li>
                        <a href="Support.aspx">
                            <i class="fa-solid fa-circle-question"></i>
                            Support
                        </a>
                    </li>
                </ul>
            </aside>

            <!-- Page Content -->
            <main class="main-content">
                <asp:ContentPlaceHolder ID="ContentPlaceHolder1" runat="server" />
            </main>

        </div>
    </form>
</body>
</html>
