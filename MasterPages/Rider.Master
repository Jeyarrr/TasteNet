<%@ Master Language="C#" AutoEventWireup="true" CodeBehind="Rider.master.cs" Inherits="TasteNet.MasterPages.Rider" %>

<!DOCTYPE html>
<html lang="en">
<head runat="server">
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0, user-scalable=yes" />
    <title>TasteNet - Rider Portal</title>

    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css" rel="stylesheet" />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&display=swap" rel="stylesheet" />

    <style>
        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }

        html, body {
            margin: 0;
            padding: 0;
            width: 100%;
            height: 100%;
        }

        body {
            font-family: 'Inter', sans-serif;
            background: #f8f9fc;
            overflow: hidden;
            position: relative;
            isolation: isolate;
        }
        
        .sidebar {
            width: 260px !important;
            min-width: 260px !important;
            max-width: 260px !important;
            height: 100vh;
            background: linear-gradient(180deg, #6b1a1a 0%, #4a0e0e 100%);
            color: #ffffff;
            position: fixed;
            top: 0;
            left: 0;
            overflow-y: auto;
            overflow-x: hidden;
            z-index: 100;
            transition: width 0.25s cubic-bezier(0.4, 0, 0.2, 1), min-width 0.25s cubic-bezier(0.4, 0, 0.2, 1), max-width 0.25s cubic-bezier(0.4, 0, 0.2, 1);
            box-shadow: 2px 0 12px rgba(0, 0, 0, 0.15);
        }
        
        .sidebar.collapsed {
            width: 70px !important;
            min-width: 70px !important;
            max-width: 70px !important;
        }
        
        .sidebar::-webkit-scrollbar { 
            width: 3px; 
        }
        
        .sidebar::-webkit-scrollbar-track { 
            background: rgba(255,255,255,0.1); 
        }
        
        .sidebar::-webkit-scrollbar-thumb { 
            background: #ffc107; 
            border-radius: 10px; 
        }
        
        .sidebar-header {
            padding: 18px 12px;
            border-bottom: 1px solid rgba(255,255,255,0.15);
            margin-bottom: 16px;
            display: flex;
            align-items: center;
            justify-content: space-between;
            transition: padding 0.25s cubic-bezier(0.4, 0, 0.2, 1);
        }
        
        .sidebar.collapsed .sidebar-header {
            padding: 18px 0;
            justify-content: center;
        }
        
        .logo-wrapper {
            display: flex;
            align-items: center;
            gap: 8px;
            transition: all 0.25s cubic-bezier(0.4, 0, 0.2, 1);
        }
        
        .sidebar.collapsed .logo-wrapper {
            justify-content: center;
        }
        
        .sidebar-header img {
            width: 38px;
            height: 38px;
            border-radius: 50%;
            object-fit: cover;
            border: 2px solid #ffc107;
            transition: transform 0.2s cubic-bezier(0.34, 1.2, 0.64, 1);
        }
        
        .sidebar-header img:hover {
            transform: scale(1.05);
        }
        
        .logo-text {
            font-size: 14px;
            font-weight: 700;
            color: #ffc107;
            letter-spacing: -0.3px;
            white-space: nowrap;
            transition: opacity 0.2s ease, visibility 0.2s ease;
        }
        
        .sidebar.collapsed .logo-text {
            display: none;
            opacity: 0;
            visibility: hidden;
        }
        

        
        .menu { 
            padding: 0 12px;
            padding-bottom: 80px;
            transition: padding 0.25s cubic-bezier(0.4, 0, 0.2, 1);
        }
        
        .sidebar.collapsed .menu {
            padding: 0 8px;
            padding-bottom: 80px;
        }
        
        .menu-title {
            font-size: 11px;
            text-transform: uppercase;
            letter-spacing: 1px;
            color: rgba(255, 255, 255, 0.5);
            padding: 12px 10px 6px 10px;
            transition: opacity 0.2s ease;
            font-weight: 600;
        }
        
        .sidebar.collapsed .menu-title {
            display: none;
        }
        
        .menu-item {
            display: flex;
            align-items: center;
            gap: 10px;
            padding: 8px 10px;
            margin-bottom: 2px;
            color: rgba(255,255,255,0.85);
            text-decoration: none;
            border-radius: 8px;
            transition: all 0.2s cubic-bezier(0.34, 1.2, 0.64, 1);
            font-size: 13px;
            font-weight: 500;
            white-space: nowrap;
            position: relative;
            overflow: hidden;
            cursor: pointer;
        }
        
        .sidebar.collapsed .menu-item {
            justify-content: center;
            padding: 8px 0;
            gap: 0;
            margin-bottom: 4px;
        }
        
        .menu-item i {
            width: 18px;
            font-size: 16px;
            color: rgba(255,255,255,0.7);
            transition: all 0.25s cubic-bezier(0.34, 1.2, 0.64, 1);
            flex-shrink: 0;
        }
        
        .sidebar.collapsed .menu-item i {
            width: auto;
            font-size: 18px;
        }
        
        .menu-item span {
            transition: all 0.2s ease;
            font-size: 13px;
            white-space: nowrap;
        }
        
        .sidebar.collapsed .menu-item span {
            display: none;
        }
        
        .menu-item:hover {
            background: rgba(255, 193, 7, 0.15);
            transform: translateX(4px);
        }
        
        .sidebar.collapsed .menu-item:hover {
            transform: translateX(0) scale(1.05);
        }
        
        .menu-item:hover i {
            color: #ffc107;
            transform: translateX(3px) scale(1.1);
        }
        
        .sidebar.collapsed .menu-item:hover i {
            transform: scale(1.15);
        }
        
        .menu-item:hover span {
            color: #ffc107;
            letter-spacing: 0.3px;
        }
        
        .menu-item::before {
            content: '';
            position: absolute;
            top: 50%;
            left: 50%;
            width: 0;
            height: 0;
            border-radius: 50%;
            background: rgba(255, 193, 7, 0.3);
            transform: translate(-50%, -50%);
            transition: width 0.5s ease, height 0.5s ease;
            pointer-events: none;
            z-index: 0;
        }
        
        .menu-item:hover::before {
            width: 200px;
            height: 200px;
        }
        
        .menu-item i,
        .menu-item span {
            position: relative;
            z-index: 1;
        }
        
        .menu-item.active {
            background: rgba(255, 193, 7, 0.2);
            box-shadow: 0 2px 8px rgba(255, 193, 7, 0.2);
        }
        
        .menu-item.active i {
            color: #ffc107;
            filter: drop-shadow(0 0 3px rgba(255, 193, 7, 0.5));
        }
        
        .menu-item.active span {
            color: #ffc107;
            font-weight: 600;
        }
        
        .menu-item.active::after {
            content: '';
            position: absolute;
            left: 0;
            top: 20%;
            height: 60%;
            width: 3px;
            background: #ffc107;
            border-radius: 0 4px 4px 0;
            box-shadow: 0 0 6px rgba(255, 193, 7, 0.6);
        }
        
        .sidebar.collapsed .menu-item.active::after {
            left: auto;
            right: 0;
            width: 3px;
        }
        
        @keyframes menuPulse {
            0% {
                box-shadow: 0 0 0 0 rgba(255, 193, 7, 0.6);
                background: rgba(255, 193, 7, 0.2);
                transform: scale(1);
            }
            25% {
                transform: scale(1.02);
            }
            50% {
                box-shadow: 0 0 0 8px rgba(255, 193, 7, 0.2);
                background: rgba(255, 193, 7, 0.35);
                transform: scale(1.02);
            }
            75% {
                transform: scale(1.01);
            }
            100% {
                box-shadow: 0 0 0 0 rgba(255, 193, 7, 0);
                background: rgba(255, 193, 7, 0.2);
                transform: scale(1);
            }
        }
        
        .menu-item.active.pulse-animation {
            animation: menuPulse 0.7s cubic-bezier(0.4, 0, 0.2, 1) 2;
        }
        
        .menu-item.active:hover {
            background: rgba(255, 193, 7, 0.3);
            transform: translateX(4px);
            box-shadow: 0 2px 12px rgba(255, 193, 7, 0.3);
        }
        
        .sidebar.collapsed .menu-item.active:hover {
            transform: scale(1.08);
        }
        
        .menu-divider {
            height: 1px;
            background: rgba(255,255,255,0.1);
            margin: 12px 0;
            position: relative;
            overflow: hidden;
            transition: background 0.3s ease;
        }
        
        .menu-divider:hover {
            background: rgba(255, 193, 7, 0.3);
        }
        
        .sidebar.collapsed .menu-divider {
            margin: 8px 0;
        }
        
        .sidebar.collapsed .menu-item {
            position: relative;
        }
        
        .sidebar.collapsed .menu-item[data-tooltip]:hover::after {
            content: attr(data-tooltip);
            position: absolute;
            left: 62px;
            background: linear-gradient(135deg, #ffc107, #ffb300);
            color: #4a0e0e;
            padding: 6px 12px;
            border-radius: 8px;
            font-size: 12px;
            font-weight: 700;
            white-space: nowrap;
            z-index: 1000;
            box-shadow: 0 4px 15px rgba(0,0,0,0.25);
            font-family: 'Inter', sans-serif;
            letter-spacing: 0.3px;
            animation: tooltipFadeIn 0.2s ease;
        }
        
        @keyframes tooltipFadeIn {
            from {
                opacity: 0;
                transform: translateX(-5px);
            }
            to {
                opacity: 1;
                transform: translateX(0);
            }
        }
        
        .content {
            margin-left: 260px;
            padding: 0;
            background: #f8f9fc;
            min-height: 100vh;
            height: 100vh;
            overflow-y: auto;
            transition: margin-left 0.25s cubic-bezier(0.4, 0, 0.2, 1);
        }
        
        .sidebar.collapsed ~ .content {
            margin-left: 70px;
        }
        
        .content::-webkit-scrollbar {
            width: 6px;
        }
        
        .content::-webkit-scrollbar-track {
            background: #e2e8f0;
            border-radius: 10px;
        }
        
        .content::-webkit-scrollbar-thumb {
            background: #cbd5e1;
            border-radius: 10px;
        }
        
        .content::-webkit-scrollbar-thumb:hover {
            background: #94a3b8;
        }
        
        .content {
            animation: contentFadeIn 0.3s ease;
        }
        
        @keyframes contentFadeIn {
            from {
                opacity: 0;
            }
            to {
                opacity: 1;
            }
        }
        
        .master-footer {
            position: absolute;
            bottom: 0;
            left: 0;
            right: 0;
            padding: 12px 16px;
            border-top: 1px solid rgba(255,255,255,0.1);
            background: rgba(0,0,0,0.1);
            transition: all 0.25s cubic-bezier(0.4, 0, 0.2, 1);
        }
        
        .sidebar.collapsed .master-footer {
            padding: 12px 0;
            display: flex;
            justify-content: center;
            margin-bottom: 60px;
        }
        
        .user-info {
            display: flex;
            align-items: center;
            gap: 10px;
            transition: all 0.2s;
        }
        
        .user-info:hover .user-avatar {
            transform: scale(1.05);
            box-shadow: 0 0 8px rgba(255, 193, 7, 0.5);
        }
        
        .sidebar.collapsed .user-info {
            justify-content: center;
        }
        
        .user-avatar {
            width: 32px;
            height: 32px;
            background: #ffc107;
            border-radius: 50%;
            display: flex;
            align-items: center;
            justify-content: center;
            color: #4a0e0e;
            font-weight: 700;
            font-size: 14px;
            flex-shrink: 0;
            transition: all 0.25s cubic-bezier(0.34, 1.2, 0.64, 1);
            cursor: default;
        }
        
        .user-details {
            flex: 1;
            min-width: 0;
            transition: opacity 0.2s ease;
        }
        
        .sidebar.collapsed .user-details {
            display: none;
            opacity: 0;
            visibility: hidden;
        }
        
        .user-name {
            font-size: 12px;
            font-weight: 600;
            color: #ffffff;
            white-space: nowrap;
            transition: color 0.2s;
        }
        
        .user-role {
            font-size: 10px;
            color: rgba(255,255,255,0.6);
            white-space: nowrap;
        }
        

        
        .notification-badge {
            margin-left: auto;
            font-size: 10px;
            padding: 2px 8px;
            background: rgba(255, 193, 7, 0.2);
            color: #ffc107;
            border-radius: 20px;
            border: 1px solid rgba(255, 193, 7, 0.3);
            transition: all 0.2s ease;
        }
        
        .menu-item:hover .notification-badge {
            background: #ffc107;
            color: #4a0e0e;
            transform: scale(1.05);
        }
        
        .sidebar.collapsed .notification-badge {
            display: none;
        }
        
        @media screen and (max-width: 768px) {
            .content {
                padding: 0;
                margin-left: 70px;
            }
            
            .sidebar {
                width: 70px !important;
                min-width: 70px !important;
                max-width: 70px !important;
            }
            
            .sidebar .logo-text,
            .sidebar .menu-item span,
            .sidebar .menu-title,
            .sidebar .user-details {
                display: none;
            }
            
            .sidebar .menu-item {
                justify-content: center;
                padding: 8px 0;
            }
            
            .sidebar .sidebar-header {
                padding: 18px 0;
                justify-content: center;
            }
            
            .sidebar .master-footer {
                padding: 12px 0;
                display: flex;
                justify-content: center;
                margin-bottom: 60px;
            }
            
            .sidebar .user-info {
                justify-content: center;
            }
            
            .content {
                margin-left: 70px;
            }
        }
        
        @media screen and (max-height: 600px) {
            .sidebar-header {
                padding: 10px 12px;
            }
            .sidebar-header img {
                width: 30px;
                height: 30px;
            }
            .logo-text {
                font-size: 12px;
            }
            .menu-item {
                padding: 6px 10px;
            }
            .menu-title {
                padding: 8px 10px 4px 10px;
            }
            .user-avatar {
                width: 28px;
                height: 28px;
                font-size: 12px;
            }
            .user-name {
                font-size: 11px;
            }
            .user-role {
                font-size: 9px;
            }
        }
    </style>
    
    <asp:ContentPlaceHolder ID="head" runat="server" />
</head>

<body>
    <form id="form1" runat="server">
        <div class="sidebar" id="masterSidebar">
            <div class="sidebar-header">
                <div class="logo-wrapper">
                    <img src="/Images/LOGO.png" alt="TasteNet Logo" 
                         onerror="this.src='https://via.placeholder.com/38?text=TN';" loading="lazy" />
                    <span class="logo-text">Caballeros Tastenet</span>
                </div>

            </div>
            
            <div class="menu" id="nav-menu">
                <a href="/Users/Rider/Dashboard.aspx" class="menu-item" id="link-dashboard" data-tooltip="Dashboard">
                    <i class="fa-solid fa-house"></i>
                    <span>Dashboard</span>
                </a>
                
                <div class="menu-divider"></div>
                
                <a href="/Users/Rider/DeliveryHistory.aspx" class="menu-item" id="link-delivery-history" data-tooltip="Delivery History">
                    <i class="fa-solid fa-motorcycle"></i>
                    <span>Delivery History</span>
                </a>
                
                <div class="menu-divider"></div>
                
                <a href="/Users/Rider/Profile.aspx" class="menu-item" id="link-profile" data-tooltip="Profile">
                    <i class="fa-solid fa-user"></i>
                    <span>Profile</span>
                </a>

                <div class="menu-divider"></div>

                <a href="/Login.aspx" class="menu-item" id="link-logout" data-tooltip="Logout">
                    <i class="fa-solid fa-right-from-bracket"></i>
                    <span>Logout</span>
                </a>
            </div>
            
            <div class="master-footer">
                <div class="user-info">
                    <div class="user-avatar" id="userAvatar">
                        <i class="fa-solid fa-motorcycle"></i>
                    </div>
                    <div class="user-details">
                        <div class="user-name" id="userName">Loading...</div>
                        <div class="user-role" id="userRole">Rider</div>
                    </div>
                </div>
            </div>
        </div>
        
        <main class="content" id="mainContent">
            <asp:ContentPlaceHolder ID="ContentPlaceHolder1" runat="server" />
        </main>
    </form>

    <script>
        (function () {
            'use strict';

            var savedState = localStorage.getItem('riderSidebarCollapsed');
            var sidebar = document.getElementById('masterSidebar');
            var chevronIcon = document.getElementById('chevronIcon');

            if (sidebar && chevronIcon) {
                if (savedState === 'true') {
                    sidebar.classList.add('collapsed');
                    chevronIcon.style.transform = 'rotate(180deg)';
                } else {
                    sidebar.classList.remove('collapsed');
                    chevronIcon.style.transform = 'rotate(0deg)';
                }
            }
        })();

        function loadUserData() {
            if (typeof PageMethods !== 'undefined' && PageMethods.GetCurrentRider) {
                PageMethods.GetCurrentRider(onUserDataSuccess, onUserDataError);
            }
            else {
                fetch('/api/GetCurrentRider.aspx')
                    .then(response => response.json())
                    .then(data => {
                        if (data.success) {
                            updateUserUI(data.rider);
                        }
                    })
                    .catch(error => {
                        console.log('Using fallback user data');
                        getRiderFromSession();
                    });
            }
        }

        function getRiderFromSession() {
            var cachedRider = sessionStorage.getItem('currentRider');
            if (cachedRider) {
                try {
                    var rider = JSON.parse(cachedRider);
                    updateUserUI(rider);
                    return;
                } catch (e) { }
            }

            var xhr = new XMLHttpRequest();
            xhr.open('GET', '/Users/Rider/GetUserInfo.aspx', true);
            xhr.onload = function () {
                if (xhr.status === 200) {
                    try {
                        var response = JSON.parse(xhr.responseText);
                        if (response.success && response.user) {
                            updateUserUI(response.user);
                            sessionStorage.setItem('currentRider', JSON.stringify(response.user));
                        } else {
                            setDefaultUser();
                        }
                    } catch (e) {
                        setDefaultUser();
                    }
                } else {
                    setDefaultUser();
                }
            };
            xhr.onerror = function () {
                setDefaultUser();
            };
            xhr.send();
        }

        function updateUserUI(user) {
            var userNameSpan = document.getElementById('userName');
            var userRoleSpan = document.getElementById('userRole');
            var userAvatarDiv = document.getElementById('userAvatar');

            if (userNameSpan) {
                var displayName = user.fullName || user.username || user.firstName || 'Rider';
                if (user.fullName && user.fullName.includes(' ')) {
                    displayName = user.fullName.split(' ')[0];
                }
                userNameSpan.textContent = displayName;
            }

            if (userRoleSpan) {
                userRoleSpan.textContent = user.role || 'Delivery Rider';
            }

            if (userAvatarDiv && !user.avatarInitial) {
                var firstLetter = (user.firstName || user.username || 'R')[0].toUpperCase();
                userAvatarDiv.innerHTML = firstLetter;
            }

            sessionStorage.setItem('currentRider', JSON.stringify(user));
        }

        function setDefaultUser() {
            var userNameSpan = document.getElementById('userName');
            if (userNameSpan) {
                userNameSpan.textContent = 'Rider';
            }

            var userRoleSpan = document.getElementById('userRole');
            if (userRoleSpan) {
                userRoleSpan.textContent = 'Delivery Staff';
            }
        }

        function onUserDataSuccess(result) {
            if (result && result.success) {
                updateUserUI(result.rider);
            } else {
                setDefaultUser();
            }
        }

        function onUserDataError(error) {
            console.log('Error loading user data:', error);
            setDefaultUser();
        }

        document.addEventListener("DOMContentLoaded", function () {
            'use strict';

            loadUserData();

            const sidebar = document.getElementById('masterSidebar');
            const collapseBtn = document.getElementById('collapseBtn');
            const chevronIcon = document.getElementById('chevronIcon');

            function collapseSidebar() {
                if (sidebar && !sidebar.classList.contains('collapsed')) {
                    requestAnimationFrame(() => {
                        sidebar.classList.add('collapsed');
                        localStorage.setItem('riderSidebarCollapsed', 'true');
                        if (chevronIcon) {
                            chevronIcon.style.transform = 'rotate(180deg)';
                        }
                    });
                }
            }

            function expandSidebar() {
                if (sidebar && sidebar.classList.contains('collapsed')) {
                    requestAnimationFrame(() => {
                        sidebar.classList.remove('collapsed');
                        localStorage.setItem('riderSidebarCollapsed', 'false');
                        if (chevronIcon) {
                            chevronIcon.style.transform = 'rotate(0deg)';
                        }
                    });
                }
            }

            function toggleSidebar() {
                if (sidebar.classList.contains('collapsed')) {
                    expandSidebar();
                } else {
                    collapseSidebar();
                }
            }

            let isToggling = false;
            if (collapseBtn) {
                collapseBtn.addEventListener('click', function (e) {
                    e.preventDefault();
                    e.stopPropagation();

                    if (isToggling) return;
                    isToggling = true;

                    toggleSidebar();

                    setTimeout(() => {
                        isToggling = false;
                    }, 250);
                });
            }

            function triggerPulseOnActiveModule() {
                const activeMenuItem = document.querySelector('.menu-item.active');
                if (activeMenuItem) {
                    activeMenuItem.classList.remove('pulse-animation');
                    void activeMenuItem.offsetWidth;
                    activeMenuItem.classList.add('pulse-animation');

                    setTimeout(() => {
                        if (activeMenuItem) {
                            activeMenuItem.classList.remove('pulse-animation');
                        }
                    }, 1500);
                }
            }

            function setActiveMenu() {
                var currentPath = window.location.pathname;
                var currentPage = currentPath.split('?')[0].toLowerCase();
                var navLinks = document.querySelectorAll('.menu-item');

                navLinks.forEach(function (link) {
                    link.classList.remove('active');
                });

                navLinks.forEach(function (link) {
                    var linkHref = link.getAttribute('href');

                    if (linkHref) {
                        var linkPath = linkHref.split('?')[0].toLowerCase();

                        if (currentPage === linkPath) {
                            link.classList.add('active');
                            return;
                        }

                        if (currentPage.includes(linkPath) && linkPath !== '/' && linkPath.length > 1) {
                            link.classList.add('active');
                            return;
                        }

                        if ((currentPage === '/' || currentPage === '/users/rider/default.aspx' || currentPage === '/default.aspx') &&
                            linkPath.includes('dashboard')) {
                            link.classList.add('active');
                            return;
                        }
                    }
                });

                if (!document.querySelector('.menu-item.active')) {
                    var pageName = currentPage.split('/').pop();

                    navLinks.forEach(function (link) {
                        var linkHref = link.getAttribute('href');
                        if (linkHref) {
                            var linkPage = linkHref.split('/').pop().toLowerCase();
                            var cleanPageName = pageName.replace('.aspx', '');
                            var cleanLinkPage = linkPage.replace('.aspx', '');

                            if (cleanPageName === cleanLinkPage) {
                                link.classList.add('active');
                                return;
                            }

                            if (cleanPageName.includes(cleanLinkPage) && cleanLinkPage.length > 3) {
                                link.classList.add('active');
                                return;
                            }
                        }
                    });
                }

                triggerPulseOnActiveModule();
            }

            setActiveMenu();

            const allMenuLinks = document.querySelectorAll('.menu-item');
            allMenuLinks.forEach(link => {
                link.addEventListener('click', function (e) {
                    const isCollapsed = sidebar.classList.contains('collapsed');
                    localStorage.setItem('riderSidebarCollapsed', isCollapsed ? 'true' : 'false');

                    const clickedLink = e.currentTarget;
                    clickedLink.style.transform = 'scale(0.98)';
                    setTimeout(() => {
                        if (clickedLink) {
                            clickedLink.style.transform = '';
                        }
                    }, 150);

                    if (clickedLink.id) {
                        sessionStorage.setItem('riderLastActiveNav', clickedLink.id);
                    }
                });
            });

            window.addEventListener('pageshow', function (event) {
                if (event.persisted) {
                    var savedState = localStorage.getItem('riderSidebarCollapsed');
                    if (sidebar) {
                        requestAnimationFrame(() => {
                            if (savedState === 'true') {
                                sidebar.classList.add('collapsed');
                                if (chevronIcon) chevronIcon.style.transform = 'rotate(180deg)';
                            } else {
                                sidebar.classList.remove('collapsed');
                                if (chevronIcon) chevronIcon.style.transform = 'rotate(0deg)';
                            }
                        });
                    }
                    setActiveMenu();
                    loadUserData();
                }
            });

            const observer = new MutationObserver(function (mutations) {
                mutations.forEach(function (mutation) {
                    if (mutation.attributeName === 'class') {
                        const savedState = localStorage.getItem('riderSidebarCollapsed');
                        const currentState = sidebar.classList.contains('collapsed') ? 'true' : 'false';
                        if (savedState !== currentState && savedState !== null) {
                            if (savedState === 'true') {
                                sidebar.classList.add('collapsed');
                                if (chevronIcon) chevronIcon.style.transform = 'rotate(180deg)';
                            } else {
                                sidebar.classList.remove('collapsed');
                                if (chevronIcon) chevronIcon.style.transform = 'rotate(0deg)';
                            }
                        }
                    }
                });
            });

            if (sidebar) {
                observer.observe(sidebar, { attributes: true });
            }

            var lastActiveId = sessionStorage.getItem('riderLastActiveNav');
            if (lastActiveId && !document.querySelector('.menu-item.active')) {
                var lastActiveLink = document.getElementById(lastActiveId);
                if (lastActiveLink) {
                    lastActiveLink.classList.add('active');
                }
            }
        });
    </script>
</body>
</html>